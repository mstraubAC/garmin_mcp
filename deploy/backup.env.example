# Template for /etc/garmin-mcp/backup.env — off-site restic backup config.
# Copy to /etc/garmin-mcp/backup.env, set mode 0600, and fill in values.
#
#   sudo install -m 600 -o root -g root deploy/backup.env.example /etc/garmin-mcp/backup.env
#   $EDITOR /etc/garmin-mcp/backup.env

# S3-compatible restic repository URL (e.g. Backblaze B2, AWS S3, MinIO).
RESTIC_REPOSITORY="s3:s3.eu-central-1.amazonaws.com/my-bucket/garmin-mcp"

# Restic repository passphrase — generate with: openssl rand -base64 32
RESTIC_PASSWORD=""

# S3 credentials (or equivalent for your storage provider).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Garmin MCP server environment file.
#
# Copy this to /etc/garmin-mcp/env, set the values, and `chmod 600` it.
# Compose passes it into the container via env_file:.
#
# Generate the secrets:
#   JWT_SIGNING_KEY    openssl rand -base64 32
#   GARMIN_MCP_DATA_KEY  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   MCP_REGISTRATION_TOKEN  openssl rand -hex 16   # optional lockdown token

# ---- Required ------------------------------------------------------------

# Public URL where Claude reaches the MCP server. Must match the redirect
# URI registered in Entra ID (publicUrl + /callback).
MCP_PUBLIC_URL=https://garmin-mcp.example.com

# 32 random bytes, base64-encoded. Used to sign access-token JWTs.
JWT_SIGNING_KEY=

# Fernet key (44 chars, base64 url-safe). Used to encrypt each user's
# stored Garmin OAuth tokens at rest. Rotating this key invalidates ALL
# stored Garmin tokens — every user has to re-onboard. Back it up.
GARMIN_MCP_DATA_KEY=

# Entra app registration outputs from `infra/azure/scripts/deploy.sh`.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---- Optional ------------------------------------------------------------

# Where the SQLite state DB lives inside the container. Default below
# matches the volume mount in docker-compose.yml — leave it unless you
# remap the volume.
# GARMIN_MCP_DATA_PATH=/var/lib/garmin-mcp/state.db

# Audit log directory inside the container. Default matches the
# garmin-mcp-logs volume.
# GARMIN_MCP_AUDIT_DIR=/var/log/garmin-mcp

# Lockdown mode for /register: when set, DCR requests must include
# `Authorization: Bearer $MCP_REGISTRATION_TOKEN`. Useful while you're
# testing the deploy and don't want random clients to register. Unset
# the line (or remove this var) once you trust the deploy.
# MCP_REGISTRATION_TOKEN=

# Set to true to use Garmin Connect China (garmin.cn) instead of the
# international service.
# GARMIN_IS_CN=false
